{
  "build": {
    "executor": "@nx/js:tsc",
    "dependsOn": ["^build"],
    "outputs": ["{options.outputPath}"],
    "options": {
      "outputPath": "dist/backend",
      "main": "backend/src/main.ts",
      "tsConfig": "backend/tsconfig.json",
      "assets": [
        {
          "input": "backend",
          "glob": "package.json",
          "output": "."
        }
      ]
    }
  }
}
