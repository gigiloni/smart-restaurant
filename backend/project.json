{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "backend",
  "projectType": "application",
  "sourceRoot": "backend/src",

  "targets": {
    "build": {
      "executor": "@nx/js:tsc",

      "dependsOn": [
        "^build"
      ],

      "outputs": [
        "{options.outputPath}"
      ],

      "options": {
        "outputPath": "dist/backend",
        "main": "backend/src/main.ts",
        "tsConfig": "backend/tsconfig.build.json",

        "assets": [
          {
            "input": "backend",
            "glob": "package.json",
            "output": "."
          }
        ]
      }
    },

    "serve": {
      "executor": "@nx/js:node",
      "continuous": true,

      "options": {
        "buildTarget": "backend:build",
        "runBuildTargetDependencies": true
      }
    },

    "prisma-generate": {
      "executor": "nx:run-commands",

      "options": {
        "cwd": "backend",
        "command": "pnpm exec prisma generate"
      }
    },

    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],

      "options": {
        "cwd": "backend",
        "command": "pnpm exec vitest run"
      }
    },

    "test-unit": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],

      "options": {
        "cwd": "backend",
        "command": "pnpm exec vitest run --project unit"
      }
    },

    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],

      "options": {
        "cwd": "backend",
        "command": "pnpm exec tsc -b tsconfig.spec.json --force"
      }
    },

    "test-integration": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],

      "options": {
        "cwd": "backend",
        "command": "pnpm exec vitest run --project integration"
      }
    }
  }
}
