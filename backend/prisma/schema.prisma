generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  ADMIN
  SERVICE
  KITCHEN
  BAR
}

enum OrderItemStatus {
  OPEN
  IN_PROGRESS
  READY
  SERVED
  REMAKE
}

/// An order is OPEN while guests can still add to it, and CLOSED once it has been
/// paid. A closed order is frozen.
enum OrderStatus {
  OPEN
  CLOSED
}

enum ProductType {
  FOOD
  DRINK
  APPETIZER
}

model Employee {
  id         Int          @id @default(autoincrement()) @map("employee_id")
  firstname  String       @db.VarChar(100)
  lastname   String       @db.VarChar(100)
  role       EmployeeRole
  authUserId String?      @unique @map("auth_user_id")
  authUser   User?        @relation(fields: [authUserId], references: [id], onDelete: SetNull)

  orders Order[]

  @@map("Employee")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  employee      Employee?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Ingredient {
  id   Int     @id @default(autoincrement()) @map("ingredient_id")
  name String? @db.VarChar(100)

  products ProductIngredient[]

  @@map("Ingredient")
}

model RestaurantTable {
  id          Int @id @default(autoincrement()) @map("table_id")
  tableNumber Int @unique @map("table_number")
  seats       Int @default(0)

  orders   Order[]
  sessions TableSession[]

  @@map("Table")
}

model Product {
  id          Int         @id @default(autoincrement()) @map("product_id")
  description String?     @db.VarChar(100)
  price       Decimal     @default(0.0)
  type        ProductType
  name        String      @db.VarChar(100)

  orderItems  OrderItem[]
  ingredients ProductIngredient[]

  @@map("Product")
}

/// One party's time at a table, from the first QR scan until service clears the
/// table. Orders belong to a session rather than directly to a table, so guest
/// access can be bound to the session and revoked when the table is cleared.
///
/// A table has at most one open session. That is enforced by a partial unique
/// index added by hand in the migration, since Prisma cannot express it.
model TableSession {
  id       Int       @id @default(autoincrement()) @map("table_session_id")
  tableId  Int       @map("table_id")
  openedAt DateTime  @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")

  table  RestaurantTable @relation(fields: [tableId], references: [id])
  orders Order[]

  // Target of the composite foreign key from Order, which keeps Order.table_id
  // equal to its session's table even when the session moves.
  @@unique([id, tableId])
  @@index([tableId])
  @@map("Table_Session")
}

model Order {
  id             Int         @id @default(autoincrement()) @map("order_id")
  tableSessionId Int         @map("table_session_id")
  tableId        Int         @map("table_id")
  employeeId     Int?        @map("employee_id")
  status         OrderStatus @default(OPEN)
  closedAt       DateTime?   @map("closed_at")

  // `tableId` is denormalised for reads, and kept honest by the composite key:
  // moving a session to another table cascades the new table onto its orders.
  tableSession TableSession    @relation(fields: [tableSessionId, tableId], references: [id, tableId], onUpdate: Cascade)
  table        RestaurantTable @relation(fields: [tableId], references: [id])
  employee     Employee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]

  @@index([tableSessionId])
  @@map("Order")
}

model OrderItem {
  id        Int             @id @default(autoincrement()) @map("order_item_id")
  orderId   Int             @map("order_id")
  productId Int             @map("product_id")
  status    OrderItemStatus @default(OPEN)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("Order_Item")
}

model ProductIngredient {
  productId    Int @map("product_id")
  ingredientId Int @map("ingredient_id")
  amount       Int @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([productId, ingredientId])
  @@map("Product_Ingredient")
}

/// Every change to an order, an order item or a table session, written in the
/// same transaction as the change itself: no event without its change, and no
/// change without its event. Clients replay from here to catch up on anything
/// they missed while disconnected.
///
/// Ids are not a sequence. They come from OrderEventCounter, whose row lock is
/// held until commit, so ids are handed out in commit order and a reader that
/// has seen event n has seen every event before it. A sequence would hand ids
/// out at insert time, and a reader could move past an id whose transaction
/// had not committed yet.
///
/// The scoping columns let a single query select exactly the events one viewer
/// may see; there is deliberately no foreign key, because events outlive the
/// rows they describe.
model OrderEvent {
  id             BigInt        @id @map("order_event_id")
  type           String        @db.VarChar(40)
  occurredAt     DateTime      @default(now()) @map("occurred_at")
  tableSessionId Int           @map("table_session_id")
  orderId        Int?          @map("order_id")
  orderItemId    Int?          @map("order_item_id")
  /// Set on item events: the product type of the item.
  productType    ProductType?  @map("product_type")
  /// Set on order and session events: every product type they contain.
  productTypes   ProductType[] @map("product_types")
  payload        Json

  @@index([tableSessionId, id])
  @@index([occurredAt])
  @@map("Order_Event")
}

/// A single row holding the id of the last order event. Bumping it takes a row
/// lock that is held until commit, which is what makes event ids follow commit
/// order.
model OrderEventCounter {
  id    Int    @id @default(1)
  value BigInt @default(0)

  @@map("Order_Event_Counter")
}
