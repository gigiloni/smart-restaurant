{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "contracts",
  "projectType": "library",
  "sourceRoot": "contracts/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "contracts/dist",
        "main": "contracts/src/index.ts",
        "tsConfig": "contracts/tsconfig.json"
      }
    }
  }
}
