{
  "name": "@smart-restaurant/source",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm db:generate && nx run-many -t serve --projects=backend,gastro-ui --parallel=2",
    "db:generate": "pnpm --dir backend exec prisma generate",
    "db:migrate": "pnpm --dir backend exec prisma migrate deploy",
    "db:seed": "pnpm --dir backend exec prisma db seed",
    "db:bootstrap-admin": "pnpm --dir backend exec node prisma/bootstrap-admin.mjs",
    "start:frontend": "nx serve gastro-ui",
    "start:backend": "pnpm db:generate && nx serve backend",
    "build": "pnpm db:generate && nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graph": "nx graph"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/router": "21.2.19",
    "@better-auth/prisma-adapter": "^1.7.5",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@primeuix/themes": "^3.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@smart-restaurant/contracts": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.5",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "primeng": "21.1.9",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.19",
    "@angular-devkit/schematics": "21.2.19",
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@angular/language-service": "21.2.19",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@schematics/angular": "21.2.19",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "nx": "23.1.1",
    "prettier": "~3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "zod-openapi": "^6.0.2"
  }
}
